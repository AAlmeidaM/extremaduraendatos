# =============================================================================
#  extremadura-en-datos - Plantilla de variables de entorno
# =============================================================================
#
#  COMO USAR ESTE ARCHIVO
#    1. Copiar a .env  ->  cp .env.example .env   (lo hace scripts\setup.ps1)
#    2. Rellenar DATABASE_URL con la salida de:
#       powershell -ExecutionPolicy Bypass -File C:\OfficeLab\scripts\pg-new-database.ps1 -Slug extremadura-en-datos
#       (scripts\setup.ps1 intenta hacerlo automáticamente)
#    3. .env NUNCA se sube a Git (ya está en .gitignore)
#
#  Referencia: C:\OfficeLab\SECURITY.md
# =============================================================================

# --- Entorno ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
LOG_DIR=E:\Lab\logs\extremadura-en-datos

# --- Base de datos ------------------------------------------------------------
# Generada por C:\OfficeLab\scripts\pg-new-database.ps1 -Slug extremadura-en-datos
DATABASE_URL=postgresql://extremadura_en_datos:CAMBIAR@127.0.0.1:5432/extremadura_en_datos

# --- Datos ---------------------------------------------------------------------
# Cache de JSON crudo descargado del INE (trazabilidad / depuración).
DATASETS_DIR=E:\Lab\datasets\extremadura-en-datos

# --- API del INE -----------------------------------------------------------
INE_API_BASE=https://servicios.ine.es/wstempus/js/ES
INE_REQUEST_TIMEOUT=30
# Pausa entre peticiones, por cortesía con un servicio público gratuito.
INE_REQUEST_DELAY_SECONDS=1

# --- API de Eurostat (opcional, 2026-09-15) ------------------------------------
# Valores por defecto en config.py; solo hace falta definirlas para cambiarlos.
# EUROSTAT_API_BASE=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0
# EUROSTAT_REQUEST_TIMEOUT=120
# EUROSTAT_REQUEST_DELAY_SECONDS=1
